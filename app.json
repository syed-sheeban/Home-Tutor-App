{
  "expo": {
    "name": "TutorNest",
    "slug": "Home-tutor-apk",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/home-tutor-icon.png",
    "scheme": "hometutorapk",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hometutor.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "tez",
          "phonepe",
          "paytmmp"
        ]
      }
    },
    "android": {
      "package": "com.hometutor.apk",
      "versionCode": 4,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/tutornest-splash.png",
          "imageWidth": 280,
          "resizeMode": "contain",
          "backgroundColor": "#07111A",
          "dark": {
            "image": "./assets/images/tutornest-splash.png",
            "backgroundColor": "#07111A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://backend-production-a779f.up.railway.app/api",
      "webAppBaseUrl": "https://backend-production-a779f.up.railway.app",
      "router": {},
      "eas": {
        "projectId": "d04f457e-4aa9-4fe5-93cf-30624a9134b8"
      }
    }
  }
}
